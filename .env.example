# Required only for live collection. Demo mode needs none of these values.
N8N_URL=http://127.0.0.1:5678
N8N_DATA=C:/Users/YOUR_USER/.n8n
# The node_modules directory inside your installed n8n package.
N8N_INSTALL=C:/Users/YOUR_USER/AppData/Roaming/npm/node_modules/n8n/node_modules
N8N_WORKFLOW_ID=YOUR_WORKFLOW_ID
N8N_PUBLIC_URL=https://n8n.example.com
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
HEALTH_PORT=8787
# Store the real file outside the repository with restrictive OS permissions.
HEALTH_AGENT_CONFIG=C:/Services/n8n-healthcheck/agent.json
